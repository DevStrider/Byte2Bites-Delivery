<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.byte2bites.delivery">

    <!-- Basic permissions for Firebase + network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name_delivery"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Byte2BitesDelivery">

    <!-- Launcher: Welcome screen -->
        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Byte2BitesDelivery">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <!-- Read-only profile screen -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Main deliveries list / home screen -->
        <activity
            android:name=".DeliveriesActivity"
            android:exported="false" />

        <activity
            android:name=".OrderDetailsActivity"
            android:exported="false" />

    </application>

</manifest>
