<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Order ID -->
        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order #123456"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <!-- Buyer name -->
        <TextView
            android:id="@+id/tvBuyerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buyer: John Doe"
            android:textSize="14sp"
            android:layout_marginTop="4dp"/>

        <!-- Restaurant name (already used in adapter) -->
        <TextView
            android:id="@+id/tvRestaurantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restaurant: My Restaurant"
            android:textSize="14sp"
            android:layout_marginTop="2dp"/>

        <!-- NEW: pickup address (used by adapter as tvPickupAddress) -->
        <TextView
            android:id="@+id/tvPickupAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup: Restaurant address"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>

        <!-- NEW: drop-off address (used by adapter as tvDropoffAddress) -->
        <TextView
            android:id="@+id/tvDropoffAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drop-off: Buyer address"
            android:textSize="13sp"
            android:layout_marginTop="2dp"/>

        <!-- Order status (used by adapter as tvStatus) -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY FOR DELIVERING"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="6dp"/>

        <!-- Total price (used by adapter as tvTotal) -->
        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total: $40.00"
            android:textSize="13sp"
            android:layout_marginTop="2dp"/>

        <!-- Time -->
        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nov 20, 2025 12:30"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnAcceptOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accept order"/>

            <Button
                android:id="@+id/btnDeliverOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark delivered"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
